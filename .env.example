# ─────────────────────────────────────────────────────────────
# FluxAssist — configurazione
# Copia questo file in `.env` e compila i valori.
# ─────────────────────────────────────────────────────────────

# Config agenzia (regole di routing: zone, soglie, mutuo...)
AGENCY_CONFIG_PATH=config/agency.example.yaml

# Database: SQLite in locale, Postgres in produzione (vedi docker-compose.yml)
DATABASE_URL=sqlite:///./fluxassist.db

# ── Canale WhatsApp attivo ───────────────────────────────────
# "meta"   = Meta WhatsApp Business Cloud API (diretta)
# "twilio" = Twilio Programmable Messaging (onboarding più semplice)
# Un solo canale è attivo alla volta: viene esposto solo il suo webhook su POST /webhook.
# Dettagli e confronto: docs/whatsapp-providers.md
WHATSAPP_PROVIDER=meta

# ── Provider "meta" (Meta Cloud API) ─────────────────────────
# Da developers.facebook.com → app Business → WhatsApp → API Setup.
# WHATSAPP_TOKEN            = token di accesso (temporaneo ~24h; permanente via System User)
# WHATSAPP_PHONE_NUMBER_ID  = "Phone number ID" mostrato nella pagina API Setup
# WHATSAPP_APP_SECRET       = Impostazioni app → Base → "App secret" (verifica firma webhook)
# WHATSAPP_VERIFY_TOKEN     = stringa che INVENTI tu; usala anche nel callback Meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ── Provider "twilio" ────────────────────────────────────────
# Da console.twilio.com → Account Info (SID e Auth Token) e Messaging → Senders → WhatsApp.
# TWILIO_ACCOUNT_SID           = "AC..." dell'account
# TWILIO_AUTH_TOKEN            = auth token dell'account (firma i webhook in entrata)
# TWILIO_WHATSAPP_NUMBER       = numero mittente, es. +14155238886 (sandbox) o il numero WhatsApp
# TWILIO_MESSAGING_SERVICE_SID = "MG..." — alternativa al numero, se usi un Messaging Service
# TWILIO_CONTENT_SID_*         = "HX..." dei template approvati (Content API), uno per template
# TWILIO_WEBHOOK_URL           = URL pubblico ESATTO configurato in Twilio; serve alla verifica
#                                della firma se gli header X-Forwarded-* non arrivano integri
# TWILIO_VALIDATE_SIGNATURE    = "false" solo in locale con ngrok/test manuali, mai in produzione
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_CONTENT_SID_REOPENER=
TWILIO_CONTENT_SID_REMINDER=
TWILIO_WEBHOOK_URL=
TWILIO_VALIDATE_SIGNATURE=true

# ── LLM (Gemini) ─────────────────────────────────────────────
# Da aistudio.google.com/apikey
# GEMINI_API_KEY = chiave API di Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# "gemini" usa l'LLM, "fallback" forza l'estrazione a regole/regex (senza API)
LLM_PROVIDER=gemini

# ── Google Calendar ──────────────────────────────────────────
# Percorso del JSON del service account (Google Cloud → Credenziali → Account di servizio → Chiavi).
# Ricorda di condividere il calendario dell'agenzia con l'email del service account.
# Il calendar_id del calendario dell'agenzia si imposta in config/agency.example.yaml.
GOOGLE_CALENDAR_CREDENTIALS=

# ── Dashboard lead (Basic Auth) ───────────────────────────────
# Credenziali per l'agente immobiliare: senza entrambe la dashboard resta bloccata
# (fail-closed). Basic Auth invia le credenziali in chiaro (base64) sulla connessione:
# va esposta solo dietro TLS (Caddy lo fa già in produzione, vedi Caddyfile).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
