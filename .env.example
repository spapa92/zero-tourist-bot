# ─────────────────────────────────────────────────────────────
# FluxAssist — configurazione
# Copia questo file in `.env` e compila i valori.
# ─────────────────────────────────────────────────────────────

# Config agenzia (regole di routing: zone, soglie, mutuo...)
AGENCY_CONFIG_PATH=config/agency.example.yaml

# Database: SQLite in locale, Postgres in produzione (vedi docker-compose.yml)
DATABASE_URL=sqlite:///./fluxassist.db

# ── WhatsApp (Meta Cloud API) ────────────────────────────────
# Da developers.facebook.com → app Business → WhatsApp → API Setup.
# WHATSAPP_TOKEN            = token di accesso (temporaneo ~24h; permanente via System User)
# WHATSAPP_PHONE_NUMBER_ID  = "Phone number ID" mostrato nella pagina API Setup
# WHATSAPP_APP_SECRET       = Impostazioni app → Base → "App secret" (verifica firma webhook)
# WHATSAPP_VERIFY_TOKEN     = stringa che INVENTI tu; usala anche nel callback Meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ── LLM (Gemini) ─────────────────────────────────────────────
# Da aistudio.google.com/apikey
# GEMINI_API_KEY = chiave API di Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# "gemini" usa l'LLM, "fallback" forza l'estrazione a regole/regex (senza API)
LLM_PROVIDER=gemini

# ── Google Calendar ──────────────────────────────────────────
# Percorso del JSON del service account (Google Cloud → Credenziali → Account di servizio → Chiavi).
# Ricorda di condividere il calendario dell'agenzia con l'email del service account.
# Il calendar_id del calendario dell'agenzia si imposta in config/agency.example.yaml.
GOOGLE_CALENDAR_CREDENTIALS=
